#!/bin/bash
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PYTHON="$(command -v python3 || true)"
if [ -z "$PYTHON" ] && [ -x /usr/bin/python3 ]; then PYTHON=/usr/bin/python3; fi
if [ -z "$PYTHON" ]; then
  /usr/bin/osascript -e 'display alert "Chrome-Patcher" message "Python 3 is required." as critical'
  exit 1
fi
exec "$PYTHON" "$ROOT/Resources/chrome_patcher.py" menu
